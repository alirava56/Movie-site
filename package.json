{
  "name": "didamesh",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "$esbuild"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run typecheck && node scripts/build.mjs",
    "start": "tsx server/index.ts",
    "test": "node --import tsx --test",
    "typecheck": "tsc -p tsconfig.server.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@fontsource-variable/vazirmatn": "5.3.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "pg": "8.23.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.6.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "typescript": "6.0.3"
  }
}
